{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Revisar resultados sin GPU",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["auditar", "--dispositivo", "cpu"],
      "env": {"CUDA_VISIBLE_DEVICES": "-1"},
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Verificar datos y funciones",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["verificar"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
